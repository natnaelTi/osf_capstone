# Server-only values. Never prefix these with VITE_ or commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
OPENAI_API_KEY=replace-with-server-only-openai-key
OPENAI_MODEL=gpt-5-mini
CRON_SECRET=replace-with-long-random-secret
ADMIN_API_KEY=replace-with-separate-long-random-secret
ALLOWED_SOURCE_HOSTS=nbe.gov.et,justice.gov.et

# Hackathon preview only. Set false for any production-like deployment.
ALLOW_DEMO_ADMIN=true
